#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
GO="${GO:-go}"
BIN_DIR="${BIN_DIR:-$ROOT_DIR/bin}"
PREFIX="${PREFIX:-/usr/local}"
BINDIR="${BINDIR:-$PREFIX/bin}"
LIBEXECDIR="${LIBEXECDIR:-$PREFIX/libexec/waypoint}"
SYSCONFDIR="${SYSCONFDIR:-/etc}"
CONFIG_DIR="${CONFIG_DIR:-$SYSCONFDIR/waypoint}"
CONFIG_PATH="${CONFIG_PATH:-$CONFIG_DIR/config.json}"

red=''; green=''; yellow=''; blue=''; reset=''
if [[ -t 1 ]]; then
  red=$'\033[0;31m'; green=$'\033[0;32m'; yellow=$'\033[1;33m'; blue=$'\033[0;34m'; reset=$'\033[0m'
fi

log() { printf '%s[waypoint]%s %s\n' "$blue" "$reset" "$*"; }
ok() { printf '%s[ok]%s %s\n' "$green" "$reset" "$*"; }
warn() { printf '%s[warn]%s %s\n' "$yellow" "$reset" "$*" >&2; }
err() { printf '%s[error]%s %s\n' "$red" "$reset" "$*" >&2; }

usage() {
  cat <<USAGE
Usage: ./setup <command>

Commands:
  build        Build bin/waypoint and bin/bash_init
  test         Run Go tests
  install      Install waypoint, bash_init, and default system config
  uninstall    Remove files installed by ./setup install
  check        Check host commands and kernel features used by Waypoint
  deps-ubuntu  Install Ubuntu/Debian host dependencies and Go
  clean        Remove local build outputs
  help         Show this help

Environment overrides:
  GO=$GO
  BIN_DIR=$BIN_DIR
  PREFIX=$PREFIX
  BINDIR=$BINDIR
  LIBEXECDIR=$LIBEXECDIR
  CONFIG_PATH=$CONFIG_PATH

Typical flow:
  sudo ./setup deps-ubuntu
  ./setup build
  sudo ./setup install
  sudo ./setup check
USAGE
}

need_cmd() {
  local cmd="$1"
  if ! command -v "$cmd" >/dev/null 2>&1; then
    err "missing command: $cmd"
    return 1
  fi
  ok "$cmd: $(command -v "$cmd")"
}

need_root() {
  if [[ "${EUID:-$(id -u)}" -ne 0 ]]; then
    err "this command requires root privileges; run it with sudo/root"
    exit 1
  fi
}

build() {
  need_cmd "$GO" >/dev/null
  log "building Waypoint binaries into $BIN_DIR"
  mkdir -p "$BIN_DIR"
  (
    cd "$ROOT_DIR"
    "$GO" build -trimpath -o "$BIN_DIR/waypoint" ./cmd/waypoint
    "$GO" build -trimpath -o "$BIN_DIR/bash_init" ./cmd/bash-init
  )
  ok "built $BIN_DIR/waypoint"
  ok "built $BIN_DIR/bash_init"
}

test_all() {
  need_cmd "$GO" >/dev/null
  log "running Go tests"
  (cd "$ROOT_DIR" && "$GO" test ./...)
}

install_all() {
  need_root
  if [[ ! -x "$BIN_DIR/waypoint" || ! -x "$BIN_DIR/bash_init" ]]; then
    warn "local binaries are missing; building before install"
    build
  fi

  log "installing waypoint to $BINDIR"
  install -d -m 0755 "$BINDIR" "$LIBEXECDIR"
  install -m 0755 "$BIN_DIR/waypoint" "$BINDIR/waypoint"
  install -m 0755 "$BIN_DIR/bash_init" "$LIBEXECDIR/bash_init"

  install -d -m 0755 "$CONFIG_DIR"
  if [[ -e "$CONFIG_PATH" && "${FORCE_CONFIG:-0}" != "1" ]]; then
    warn "preserving existing $CONFIG_PATH"
    warn "set FORCE_CONFIG=1 to replace it with the default installed-helper config"
  else
    log "writing $CONFIG_PATH"
    local tmp
    tmp="$(mktemp)"
    printf '{\n  "bash_init_src": "%s"\n}\n' "$LIBEXECDIR/bash_init" >"$tmp"
    install -m 0644 "$tmp" "$CONFIG_PATH"
    rm -f "$tmp"
  fi

  ok "installed waypoint"
  ok "run: waypoint version"
}

uninstall_all() {
  need_root
  log "removing installed Waypoint files"
  rm -f "$BINDIR/waypoint"
  rm -f "$LIBEXECDIR/bash_init"
  rmdir "$LIBEXECDIR" 2>/dev/null || true
  warn "left $CONFIG_PATH in place; remove it manually if you no longer need it"
  ok "uninstall complete"
}

clean() {
  log "removing local build outputs"
  rm -rf "$BIN_DIR"
  rm -f "$ROOT_DIR/waypoint" "$ROOT_DIR/bash_init" "$ROOT_DIR/checkpoint-lite"
  ok "clean"
}

check_command_set() {
  local status=0
  local required=(criu crit mount umount findmnt lsof fuser ps bash ldd)
  local optional=(buildah rsync gpgv)

  log "checking required host commands"
  for cmd in "${required[@]}"; do
    if ! need_cmd "$cmd"; then status=1; fi
  done

  log "checking optional commands"
  for cmd in "${optional[@]}"; do
    if command -v "$cmd" >/dev/null 2>&1; then
      ok "$cmd: $(command -v "$cmd")"
    else
      warn "missing optional command: $cmd"
    fi
  done
  return "$status"
}

check_kernel() {
  local status=0
  local criu_output=""

  log "checking operating system"
  if [[ "$(uname -s)" == "Linux" ]]; then
    ok "Linux kernel: $(uname -r)"
  else
    err "Waypoint requires Linux"
    status=1
  fi

  log "checking OverlayFS support"
  if [[ -r /proc/filesystems ]] && grep -qw overlay /proc/filesystems; then
    ok "OverlayFS is listed in /proc/filesystems"
  else
    warn "OverlayFS is not listed in /proc/filesystems; it may be unavailable or not loaded"
  fi

  log "checking CRIU"
  if command -v criu >/dev/null 2>&1; then
    if criu_output="$(criu check 2>&1)"; then
      ok "criu check passed"
    else
      err "criu check failed"
      printf '%s\n' "$criu_output" >&2
      status=1
    fi

    if criu_output="$(criu check --all 2>&1)"; then
      ok "criu check --all passed"
    else
      warn "criu check --all reported missing optional kernel features"
      printf '%s\n' "$criu_output" >&2
    fi
  fi
  return "$status"
}

check_all() {
  need_root
  local status=0
  check_command_set || status=1
  check_kernel || status=1

  log "checking local build outputs"
  if [[ -x "$BIN_DIR/waypoint" ]]; then ok "$BIN_DIR/waypoint exists"; else warn "$BIN_DIR/waypoint does not exist; run ./setup build"; fi
  if [[ -x "$BIN_DIR/bash_init" ]]; then ok "$BIN_DIR/bash_init exists"; else warn "$BIN_DIR/bash_init does not exist; run ./setup build"; fi

  if [[ "$status" -eq 0 ]]; then ok "host checks completed"; else err "host checks found missing required pieces"; fi
  return "$status"
}

go_required_version() {
  awk '/^go / { print $2; exit }' "$ROOT_DIR/go.mod"
}

version_ge() {
  local have="$1"
  local want="$2"
  [[ "$(printf '%s\n' "$want" "$have" | sort -V | head -n1)" == "$want" ]]
}

go_current_version() {
  "$GO" version | awk '{ print $3 }' | sed 's/^go//'
}

install_go() {
  local want="${GO_VERSION:-$(go_required_version)}"
  local current=""

  if command -v "$GO" >/dev/null 2>&1; then
    current="$(go_current_version)"
    if version_ge "$current" "$want"; then
      ok "Go is already available: $("$GO" version)"
      return 0
    fi
    warn "Go $current is older than required Go $want; replacing /usr/local/go"
  else
    warn "Go is not installed; installing Go $want"
  fi

  local arch=""
  case "$(uname -m)" in
    x86_64 | amd64)
      arch="amd64"
      ;;
    aarch64 | arm64)
      arch="arm64"
      ;;
    *)
      err "unsupported architecture for automatic Go install: $(uname -m)"
      return 1
      ;;
  esac

  local tarball="go${want}.linux-${arch}.tar.gz"
  local url="${GO_DOWNLOAD_URL:-https://go.dev/dl/${tarball}}"
  local tmpdir=""
  tmpdir="$(mktemp -d)"

  log "downloading $url"
  curl -fsSL "$url" -o "$tmpdir/$tarball"

  log "installing Go $want to /usr/local/go"
  rm -rf /usr/local/go
  tar -C /usr/local -xzf "$tmpdir/$tarball"
  ln -sf /usr/local/go/bin/go /usr/local/bin/go
  ln -sf /usr/local/go/bin/gofmt /usr/local/bin/gofmt
  rm -rf "$tmpdir"

  ok "installed $(/usr/local/go/bin/go version)"
}

is_ubuntu() {
  [[ -r /etc/os-release ]] || return 1
  # shellcheck disable=SC1091
  . /etc/os-release
  [[ "${ID:-}" == "ubuntu" ]]
}

enable_ubuntu_universe() {
  if is_ubuntu && command -v add-apt-repository >/dev/null 2>&1; then
    log "enabling Ubuntu universe repository"
    add-apt-repository -y universe || warn "could not enable universe repository"
    apt-get update
  fi
}

install_criu() {
  if command -v criu >/dev/null 2>&1 && command -v crit >/dev/null 2>&1; then
    ok "CRIU is already available: $(command -v criu)"
    ok "crit is already available: $(command -v crit)"
    return 0
  fi

  log "installing CRIU"
  if DEBIAN_FRONTEND=noninteractive apt-get install -y criu; then
    ok "installed CRIU from configured apt repositories"
    return 0
  fi

  if is_ubuntu; then
    warn "CRIU was not available from current apt repositories; enabling ppa:criu/ppa"
    add-apt-repository -y ppa:criu/ppa
    apt-get update
    DEBIAN_FRONTEND=noninteractive apt-get install -y criu
    ok "installed CRIU from ppa:criu/ppa"
    return 0
  fi

  err "CRIU was not available from configured apt repositories"
  err "Install CRIU manually for this distribution, then rerun ./setup check"
  return 1
}

deps_ubuntu() {
  need_root
  if ! command -v apt-get >/dev/null 2>&1; then
    err "apt-get was not found; deps-ubuntu only supports Ubuntu/Debian-like systems"
    exit 1
  fi

  log "preparing apt dependencies"
  apt-get update
  DEBIAN_FRONTEND=noninteractive apt-get install -y \
    ca-certificates \
    curl \
    software-properties-common \
    tar

  enable_ubuntu_universe

  log "installing common Waypoint host dependencies with apt-get"
  DEBIAN_FRONTEND=noninteractive apt-get install -y \
    bash \
    buildah \
    gpgv \
    lsof \
    make \
    procps \
    psmisc \
    rsync \
    util-linux

  install_criu
  install_go
}

cmd="${1:-help}"
case "$cmd" in
  build) build ;;
  test) test_all ;;
  install) install_all ;;
  uninstall) uninstall_all ;;
  check) check_all ;;
  deps-ubuntu) deps_ubuntu ;;
  clean) clean ;;
  help | -h | --help) usage ;;
  *) err "unknown command: $cmd"; usage >&2; exit 2 ;;
esac
